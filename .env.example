# Copy to .env and fill in:  cp .env.example .env
# .env is gitignored. Never commit real secrets.

ENVIRONMENT=local
LOG_LEVEL=INFO
LOG_JSON=true

# --- Postgres 16 + pgvector (app DB) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=amlens
POSTGRES_USER=amlens
POSTGRES_PASSWORD=amlens

# --- MS SQL Server (transaction warehouse) ---
# SA password must be 8+ chars with upper, lower, digit and symbol, or the container exits.
MSSQL_HOST=localhost
MSSQL_PORT=1433
MSSQL_DB=master
MSSQL_USER=sa
MSSQL_PASSWORD=Amlens_Dev_2026!
MSSQL_DRIVER=ODBC Driver 18 for SQL Server

# --- MLflow ---
MLFLOW_PORT=5001
MLFLOW_TRACKING_URI=http://localhost:5001

# --- Kaggle (for scripts/download_data.py) ---
# Either put kaggle.json in ~/.kaggle/ or set these two:
KAGGLE_USERNAME=
KAGGLE_KEY=
